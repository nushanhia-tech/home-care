NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required server-only key for username accounts. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Initial administrator setup only; choose a private value before first use if preferred.
ADMIN_INITIAL_PASSWORD=admin123
# Optional payment integration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Administrator privileges are enforced server-side, never from editable user metadata.
# Stable server-only OTP encryption/HMAC key (random 32+ characters). Never NEXT_PUBLIC_.
OTP_HMAC_SECRET=
# Optional self-hosted Coturn REST-auth credentials. Same secret as the TURN server.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
# Optional authenticated external maintenance trigger (/api/cron/maintenance).
# Supabase pg_cron (supabase/scheduler.sql) is the preferred no-external-secret scheduler.
CRON_SECRET=
